# Per-machine Compose settings. Copy to .env (git-ignored) on each machine.
# See docs/tailscale-deployment.md.

# Address the node ports are published on. Default 127.0.0.1 (this machine
# only). For a Tailscale pool, set this machine's `tailscale ip -4`.
NODE_BIND=127.0.0.1

# Peer file the gateway reads from config/. Set peers.tailnet.yaml on the
# gateway machine of a Tailscale pool.
GATEWAY_PEERS=peers.yaml

# Address the gateway/GUI is published on. Keep 127.0.0.1 when sharing it
# with `tailscale serve`; set the Tailscale IP to serve plain HTTP on the tailnet.
GUI_BIND=127.0.0.1

# Optional: require "Authorization: Bearer <token>" on /api/*. The GUI cannot
# send it yet, so leave it empty when using the GUI. Never commit a real value.
GATEWAY_TOKEN=
